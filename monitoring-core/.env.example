# Sao chép file này thành .env rồi chỉnh theo máy bạn

# ----- Chạy MỘT MÌNH (dev, tự test) -----
# Mặc định dùng SQLite, tự tạo bảng, tự thêm monitor mẫu -> chạy ngay.
DATABASE_URL=sqlite+aiosqlite:///./monitoring.db
AUTO_CREATE_TABLES=true
SEED_SAMPLE_MONITORS=true

# ----- Khi GHÉP CHUNG với Backend API (TV2) trên Postgres -----
# Đổi lại như sau (TV4 đặt trong docker-compose):
# DATABASE_URL=postgresql+asyncpg://app:<mật khẩu>@db:5432/monitoring
# AUTO_CREATE_TABLES=false      # để TV2 (Backend API) làm chủ việc tạo bảng
# SEED_SAMPLE_MONITORS=false    # monitor do khách tạo qua API của TV2, không seed

# Nơi gửi sự kiện cảnh báo cho TV5 (Telegram bot).
# Để trống = chỉ in ra console (dùng khi tự test).
# Khi ghép nhóm: ALERT_WEBHOOK_URL=http://telegram-bot:8080/alerts
ALERT_WEBHOOK_URL=

# Số worker chạy kiểm tra song song
MAX_CONCURRENT_CHECKS=50
