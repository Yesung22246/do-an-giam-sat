# Sao chép file này thành .env rồi chỉnh theo máy bạn

# Chuỗi kết nối database.
# Mặc định dùng SQLite (chạy ngay, không cần cài gì).
# Khi ghép với nhóm, đổi sang Postgres của TV2/TV4, ví dụ:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/monitoring
DATABASE_URL=sqlite+aiosqlite:///./monitoring.db

# Nơi gửi sự kiện cảnh báo cho TV5 (Telegram bot).
# Để trống = chỉ in ra console (dùng khi tự test).
# Khi ghép nhóm, điền URL webhook mà TV5 cung cấp:
# ALERT_WEBHOOK_URL=http://localhost:8080/alerts
ALERT_WEBHOOK_URL=

# Số worker chạy kiểm tra song song
MAX_CONCURRENT_CHECKS=50
