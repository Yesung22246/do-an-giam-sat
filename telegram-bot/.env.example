# Dùng cùng DATABASE_URL với backend-api/monitoring-core.
DATABASE_URL=postgresql+asyncpg://app:change-me@db:5432/monitoring

# Tạo bot bằng BotFather. Không commit token thật.
TELEGRAM_BOT_TOKEN=
# URL public HTTPS của endpoint /telegram/webhook.
TELEGRAM_WEBHOOK_URL=https://your-domain.example/telegram/webhook
# Chuỗi 1–256 ký tự A-Z, a-z, 0-9, _ hoặc -; Telegram gửi lại trong header.
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret

# Chỉ backend-api dùng key này để yêu cầu mã ghép tài khoản.
TELEGRAM_LINK_API_KEY=replace-with-a-long-random-secret
TELEGRAM_LINK_CODE_TTL_SECONDS=600

# Báo cáo lúc 08:00 giờ Việt Nam; tuần bắt đầu thứ Hai.
REPORT_TIMEZONE=Asia/Ho_Chi_Minh
REPORT_DAILY_HOUR=8
REPORT_WEEKLY_DAY=mon
REPORT_WEEKLY_HOUR=8
REPORT_POLL_SECONDS=60
AUTO_CREATE_BOT_TABLES=true
